; JSON5's render: a tree's events written as one JSON5 document. This is
; a library of definitions, each named `json5-...`, which a host links
; with its own program (alchemy's `compile_sources`); its entry point is
; `json5-render`, and nothing else here is the host's to call.
;
; The profile is JSON's syntax exactly, which JSON5 reads, written
; compact: no whitespace between tokens, and one line feed after the
; root value, as alchemy's `json` ends its document. A key and a string
; are written through `quoted` (JSON's escapes, and the C1 controls,
; U+FFFE and U+FFFF as `\uXXXX`, all of which JSON5 reads), a number by
; its lexeme, or as the JSON renderer writes it when the document's
; spelling did not reach the render, `true`, `false` and `null` by name,
; an object as `{"k":v,"k2":v2}`, an array as `[a,b]`, and an empty one
; as `{}` or `[]`. A number that is not finite, which JSON has no
; spelling for, is written as JSON5 spells it, `Infinity`, `-Infinity`
; or `NaN`, decided by `number-class`. The root may be any value: an
; object, an array or a scalar.
;
; The events are a tree's: an object holds each key once. A walked value
; is one by construction; a host that streams a parse must refuse a
; member the parse repeats, since the render writes what it is given and
; a JSON5 reader keeps the last value of a repeated key, or merges two
; objects.
;
; The state is the stack of open containers, one marker each, so it grows
; with a document's nesting and never with its width or its length:
; `:object-open` for an object with nothing written yet, `:object` for
; one waiting for a key after a member, `:member` for one whose key is
; written and waits for the value; `:array-open` for an array with
; nothing written yet and `:array` for one waiting for an item after
; another. The markers decide the separators, and nothing is kept per
; key or per item: a comma before a member or an item that follows one,
; a colon after a key, and a line feed after the root value. Once the
; root value is written the state is `[:root-done]`, and nothing may
; follow it. Events no tree has fail with PROTOCOL_ORDER_ERROR, saying so.

; The top marker, or `:none` before the root value.
def json5-top [s]
  match (count s)
    case 0 :none
    case _ (top s)

; The top container under another marker.
def json5-mark [marker s]
  push marker (pop s)

; A value completed: an object waiting for its member's value waits for
; its next key, and the root value, once written, is the document.
def json5-done [s]
  match (count s)
    case 0 [:root-done]
    case _
      match (json5-top s)
        case :member (json5-mark :object s)
        case _ s

; What comes before a value whose parent is the top of s: a comma after
; an item that follows one; nothing at the root, after a key, or before
; a first item.
def json5-lead [s]
  match (json5-top s)
    case :array ","
    case _ ""

; What comes after a value whose parent is the top of s: the line feed
; that ends the document after the root value; nothing inside a
; container.
def json5-tail [s]
  match (count s)
    case 0 "\n"
    case _ ""

; An array waiting for its first item has it: the next item follows a
; comma.
def json5-opened [s]
  match (json5-top s)
    case :array-open (json5-mark :array s)
    case _ s

; The state a value may begin in: anywhere but an object waiting for a key.
def json5-value [s]
  match (json5-top s)
    case :object-open (fail :protocol-order "the events hold a value where a key is due, which a tree's never do")
    case :object (fail :protocol-order "the events hold a value where a key is due, which a tree's never do")
    case _ s

; A number by its lexeme, or as the JSON renderer writes it when it has
; none; one that is not finite as JSON5 spells it.
def json5-number [n]
  match (number-class n)
    case :finite (scalar-text csv-options n)
    case :infinity "Infinity"
    case :negative-infinity "-Infinity"
    case :nan "NaN"

def json5-scalar [value]
  match (kind value)
    case :null "null"
    case :boolean
      match value
        case true "true"
        case false "false"
    case :number (json5-number value)
    case _ (quoted value)

; A key, written where the object's keys go: after a comma when a member
; precedes it, and before its colon.
def json5-member [name s]
  match (json5-top s)
    case :object-open (transition (json5-mark :member s) [(quoted name) ":"])
    case :object (transition (json5-mark :member s) ["," (quoted name) ":"])
    case _ (fail :protocol-order "the events hold a key where a value is due, which a tree's never do")

def json5-step [s event]
  match (json5-top s)
    case :root-done (fail :protocol-order "the events hold more after the root value, which a tree's never do")
    case _ (json5-event s event)

def json5-event [s event]
  match event
    case array-start (transition (push :array-open (json5-opened (json5-value s))) [(json5-lead s) "["])
    case object-start (transition (push :object-open (json5-opened (json5-value s))) [(json5-lead s) "{"])
    case (key name) (json5-member name s)
    case (scalar value)
      let [s2 (json5-opened (json5-value s))]
        transition (json5-done s2) [(json5-lead s) (json5-scalar value) (json5-tail s)]
    case object-end
      match (json5-top s)
        case :object-open (transition (json5-done (pop s)) ["}" (json5-tail (pop s))])
        case :object (transition (json5-done (pop s)) ["}" (json5-tail (pop s))])
        case :member (fail :protocol-order "the events end an object after a key and before its value, which a tree's never do")
        case _ (fail :protocol-order "the events end an object that is not open, which a tree's never do")
    case array-end
      match (json5-top s)
        case :array-open (transition (json5-done (pop s)) ["]" (json5-tail (pop s))])
        case :array (transition (json5-done (pop s)) ["]" (json5-tail (pop s))])
        case _ (fail :protocol-order "the events end an array that is not open, which a tree's never do")

def json5-finish [s]
  match (json5-top s)
    case :root-done []
    case :none (fail :protocol-order "the events hold no value, where a tree's hold one")
    case _ (fail :protocol-order "the events ended inside a container")

; The render: the tree's events in, the document's text out.
def json5-render [input]
  join ""
    scan-emit [] json5-step json5-finish (events input)
