{
  "$schema": "https://tabnas.dev/schema/plugin.schema.json",
  "name": "@tabnas/json5",
  "go": "github.com/tabnas/json5/go",
  "rust": "tabnas-json5",
  "description": "JSON5 parsing for the tabnas engine.",
  "base": "@tabnas/jsonic",
  "engine": "@tabnas/parser",
  "grammar": "json5-grammar.jsonic",
  "extensions": [
    ".json5"
  ],
  "languageId": "json5",
  "pluginKind": "grammar",
  "grammarKind": "closure",
  "lexStream": "clean",
  "syncGroups": [
    "end",
    "comma",
    "close",
    "sync"
  ],
  "specDir": "test/spec",
  "clib": {
    "dir": "go/clib",
    "library": "libtabnasjson5",
    "abi": "v1",
    "errorCodes": [
      "usage",
      "grammar",
      "handle",
      "internal"
    ]
  },
  "errorCodes": [
    "json5_empty",
    "json5_no_value"
  ],
  "docs": "https://tabnas.dev/docs/packages",
  "repository": "https://github.com/tabnas/json5",
  "versionSource": "ts/package.json",
  "translate": {
    "reads": "tree",
    "writes": "tree",
    "root": "any",
    "render": "alchemy/render.alc",
    "loss": [
      "Comments are not kept.",
      "Trailing commas are not kept.",
      "Unquoted keys, single-quoted strings, hexadecimal numbers, leading and trailing decimal points, plus signs and line continuations are written in JSON's forms.",
      "A number that is not finite is written Infinity, -Infinity or NaN, as JSON5 spells it."
    ]
  }
}
